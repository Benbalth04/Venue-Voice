# ======================================================================================
# .env.example — copy to .env.development or .env.production and fill in real values.
# All variables are required unless a default is noted.
# ======================================================================================

# ======================
# CORS Configuration
# CSV list of allowed origins for the FastAPI CORS middleware.
# Dev: http://localhost:3000   Prod: https://yourdomain.com
# ======================
CORS_ORIGINS=http://localhost:3000

# ======================
# Database
# Dev: local Docker postgres. Prod: Supabase postgres (set DATABASE_HOST to your
#      Supabase DB host and DATABASE_URL to the Supabase connection string).
# NOTE: DATABASE_URL must be written out in full — env_file does not interpolate ${VAR}.
# DATABASE_PASSWORD is required for the local Docker postgres container to initialise.
# ======================
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=feedback
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_URL=postgresql+psycopg2://your_db_user:your_db_password@database:5432/feedback

# ======================
# Supabase (auth + storage)
# Find these in: Supabase Dashboard → Project Settings → API
# PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY is frontend-only (passed as a Next.js build arg).
# ======================
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
PUBLIC_SUPABASE_JWT_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
PUBLIC_SUPABASE_JWT_AUD=authenticated

# ======================
# Backend / Frontend URLs
# BACKEND_BASE_URL: externally reachable API URL (used by frontend)
# APP_ORIGIN: frontend URL (used in email links, Stripe return URLs)
# Dev:  http://localhost:5000 / http://localhost:3000
# Prod: https://api.yourdomain.com / https://yourdomain.com
# ======================
BACKEND_BASE_URL=http://localhost:5000
APP_ORIGIN=http://localhost:3000

# ======================
# Caddy (docker compose — production overlay)
# CADDY_PUBLISH_80: host port for Caddy HTTP (dev default 5000 via compose; set 80 in prod)
# API_HOST: public API hostname for TLS in Caddyfile (no scheme), e.g. api.yourdomain.com
# ======================
# CADDY_PUBLISH_80=80
# API_HOST=api.yourdomain.com

# ======================
# OpenAI (sentiment analysis)
# ======================
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_SENTIMENT_MODEL=gpt-4o-mini

# ======================
# Resend (transactional email)
# ======================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=info@yourdomain.com

# ======================
# Stripe (billing)
# Dev:  use sk_test_* keys and test price IDs
# Prod: use sk_live_* keys and live price IDs — never mix!
# ======================
DEFAULT_FREE_TRIAL_DAYS=7

STARTER_PLAN_MONTHLY_PRICE_ID=price_your_starter_monthly
STARTER_PLAN_YEARLY_PRICE_ID=price_your_starter_yearly

GROWTH_PLAN_MONTHLY_PRICE_ID=price_your_growth_monthly
GROWTH_PLAN_YEARLY_PRICE_ID=price_your_growth_yearly

PRO_PLAN_MONTHLY_PRICE_ID=price_your_pro_monthly
PRO_PLAN_YEARLY_PRICE_ID=price_your_pro_yearly

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CUSTOMER_PORTAL_ID=bpc_your_customer_portal_config_id

# ======================
# Redis (default matches Docker Compose service name)
# ======================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your_redis_password

# ======================
# Uptime Kuma (production monitoring — docker-compose.production.yml)
# Used by the uptime_kuma_provisioner service to create monitors on first deploy.
# ======================
UPTIME_KUMA_ADMIN_USER=admin
UPTIME_KUMA_ADMIN_PASSWORD=your_uptime_kuma_password