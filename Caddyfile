# Production Caddy. Set API_HOST in the caddy service environment (e.g. .env.production).
#
# Blue/green: change backend_blue to backend_green in reverse_proxy below, then:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# TLS: All domains use a Cloudflare Origin Certificate (*.venuevoice.com.au).
# ACME / Let's Encrypt is NOT used — Origin Certs bypass the Cloudflare Access
# ACME-challenge-blocking problem and work with Cloudflare Full (Strict) SSL mode.
#
# To set up the cert: Cloudflare Dashboard → SSL/TLS → Origin Server → Create Certificate
# Save as certs/cloudflare-origin.pem and certs/cloudflare-origin.key on the server.
# Never commit the certs/ directory.
#
# trusted_proxies: Caddy restores the real client IP from X-Forwarded-For only
# when requests arrive from these Cloudflare IP ranges.
# Source: https://www.cloudflare.com/ips/   Review quarterly.
{
	servers {
		trusted_proxies static \
			103.21.244.0/22 \
			103.22.200.0/22 \
			103.31.4.0/22 \
			104.16.0.0/13 \
			104.24.0.0/14 \
			108.162.192.0/18 \
			131.0.72.0/22 \
			141.101.64.0/18 \
			162.158.0.0/15 \
			172.64.0.0/13 \
			173.245.48.0/20 \
			188.114.96.0/20 \
			190.93.240.0/20 \
			197.234.240.0/22 \
			198.41.128.0/17 \
			2400:cb00::/32 \
			2606:4700::/32 \
			2803:f800::/32 \
			2405:b500::/32 \
			2405:8100::/32 \
			2a06:98c0::/29 \
			2c0f:f248::/32
	}
}

{$API_HOST:api.example.com} {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key

	request_body {
		max_size 15MB
	}

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
		X-Permitted-Cross-Domain-Policies "none"
	}

	reverse_proxy backend_blue:5000 {
		transport http {
			dial_timeout 10s
			read_timeout 60s
			write_timeout 60s
		}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

status.venuevoice.com.au {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key

	reverse_proxy uptime_kuma:3001 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

grafana.venuevoice.com.au {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key

	reverse_proxy grafana:3000 {
		# Grafana requires Host forwarded as upstream address for redirects and WebSocket live streaming
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
