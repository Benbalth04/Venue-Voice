{
  "id": null,
  "uid": "venue-voice-external-deps",
  "title": "External Dependencies",
  "description": "Database query rates and latency, and external API call rates and latency (OpenAI, Resend, Stripe, Supabase)",
  "tags": ["venue-voice", "database", "external-api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "custom",
        "current": { "value": "backend.*", "text": "backend.*" },
        "options": [
          { "value": "backend.*", "text": "All backends", "selected": true },
          { "value": "backend-blue", "text": "backend-blue", "selected": false },
          { "value": "backend-green", "text": "backend-green", "selected": false }
        ],
        "query": "backend.*,backend-blue,backend-green"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "DB Query Rate by Operation (queries/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (db_operation) (rate({container_name=~\"$container\"} | json | event_type=`db_query` [2m]))",
          "legendFormat": "{{db_operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "DB Query Latency Percentiles (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.50, {container_name=~\"$container\"} | json | event_type=`db_query` | unwrap latency_ms [2m])",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.95, {container_name=~\"$container\"} | json | event_type=`db_query` | unwrap latency_ms [2m])",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.99, {container_name=~\"$container\"} | json | event_type=`db_query` | unwrap latency_ms [2m])",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "DB Query Volume (total in window)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 50000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container_name=~\"$container\"} | json | event_type=`db_query` [$__range]))",
          "legendFormat": "Total queries",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "DB Avg Latency by Operation (ms)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "avg by (db_operation) (avg_over_time({container_name=~\"$container\"} | json | event_type=`db_query` | unwrap latency_ms [$__range]))",
          "legendFormat": "{{db_operation}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "External API Call Rate by Service (calls/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (api_service) (rate({container_name=~\"$container\"} | json | event_type=`external_api_call` [2m]))",
          "legendFormat": "{{api_service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "External API p95 Latency by Service (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.95, {container_name=~\"$container\"} | json | event_type=`external_api_call` | unwrap latency_ms [2m]) by (api_service)",
          "legendFormat": "{{api_service}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "External API Error Rate by Service (errors/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (api_service) (rate({container_name=~\"$container\"} | json | event_type=`external_api_call` | status=`error` [2m]))",
          "legendFormat": "{{api_service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "External API Call Count by Service & Operation",
      "type": "table",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "api_service" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          },
          {
            "matcher": { "id": "byName", "options": "api_operation" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sort_desc(sum by (api_service, api_operation) (count_over_time({container_name=~\"$container\"} | json | event_type=`external_api_call` [$__range])))",
          "legendFormat": "{{api_service}} / {{api_operation}}",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
