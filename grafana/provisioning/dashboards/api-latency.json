{
  "id": null,
  "uid": "venue-voice-api-latency",
  "title": "API Latency",
  "description": "HTTP request rates, latency percentiles, error rates, and top endpoints",
  "tags": ["venue-voice", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },

  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": {
          "refId": "A",
          "query": "label_values({job=\"docker\"}, service)"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "options": [
          { "value": "info", "text": "info" },
          { "value": "warning", "text": "warning" },
          { "value": "error", "text": "error" }
        ],
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  },

  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"docker\"} | json | event_type=\"request_completed\" [5m]))"
        }
      ]
    },

    {
      "id": 2,
      "title": "Latency Percentiles (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.50, {job=\"docker\"} | json | event_type=\"request_completed\" | unwrap latency_ms [5m])"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.95, {job=\"docker\"} | json | event_type=\"request_completed\" | unwrap latency_ms [5m])"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.99, {job=\"docker\"} | json | event_type=\"request_completed\" | unwrap latency_ms [5m])"
        }
      ]
    },

    {
      "id": 3,
      "title": "Error Rate (4xx + 5xx req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"docker\"} | json | event_type=\"request_completed\" | status_code=~\"4..|5..\" [5m]))"
        }
      ]
    },

    {
      "id": 4,
      "title": "Status Code Distribution",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "instant": true,
          "expr": "sum by (status_code) (count_over_time({job=\"docker\"} | json | event_type=\"request_completed\" [$__range]))"
        }
      ]
    },

    {
      "id": 5,
      "title": "Top Endpoints by Avg Latency (ms)",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "instant": true,
          "expr": "topk(10, avg by (path) (avg_over_time({job=\"docker\"} | json | event_type=\"request_completed\" | unwrap latency_ms [$__range])))"
        }
      ]
    },

    {
      "id": 6,
      "title": "Request Volume by Endpoint",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "instant": true,
          "expr": "topk(10, sum by (path) (count_over_time({job=\"docker\"} | json | event_type=\"request_completed\" [$__range])))"
        }
      ]
    }
  ]
}